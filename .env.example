# The suite gateway from welinc-workspace (port 3000). It routes /auth/* to shared auth
# (welinc-auth) and /bms/* to the BMS backend.
# - Android emulator: http://10.0.2.2:3000
# - Phone with Expo Go: this computer's Wi-Fi IP, e.g. http://192.168.1.20:3000
#   (allow port 3000 through Windows Firewall the first time)
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"

# Sign in with the seeder accounts in seeders/user.ts instead of the backend (no server data).
# Never set this to "true" in a release build.
EXPO_PUBLIC_USE_SEEDER_AUTH="false"
